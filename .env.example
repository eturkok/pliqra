# Docker Compose loads .env automatically. All values are optional.
PLIQRA_HTTP_PORT=8088

# Set these together for an HTTPS deployment behind your reverse proxy.
# PLIQRA_PUBLIC_URL=https://pliqra.example.com
# PLIQRA_SECURE_COOKIES=1

# Optional externally managed Fernet key. Preserve it across restarts.
# PLIQRA_ENCRYPTION_KEY=

# For a local Python process (Docker persists /data automatically):
# PLIQRA_DATA_DIR=./data
# PLIQRA_HOST=127.0.0.1
# PLIQRA_PORT=8080

# Source-only operational tools (not in the published 2.4.1 image).
# Trust only the proxy networks you operate; direct peers ignore forwarded IPs.
# PLIQRA_TRUSTED_PROXIES=10.42.4.0/24
# Optional content-free tracing to an OTLP HTTP/protobuf collector.
# PLIQRA_OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=3
# Keep OTEL_EXPORTER_OTLP_TRACES_HEADERS in a deployment Secret.
