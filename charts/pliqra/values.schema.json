{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pliqra Helm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "sqlite",
            "postgresql"
          ]
        }
      },
      "required": [
        "mode"
      ]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)?$"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod"
            ]
          }
        }
      },
      "required": [
        "existingClaim",
        "size",
        "storageClass",
        "accessModes"
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "existingSecret",
            "caKey"
          ]
        }
      },
      "required": [
        "existingSecret",
        "urlKey",
        "schema",
        "tls"
      ]
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "existingSecret",
        "key"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^/\\s]+$"
        },
        "secureCookies": {
          "type": "boolean"
        },
        "revision": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "publicUrl",
        "secureCookies",
        "revision"
      ]
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "multiDC": {
          "type": "boolean"
        },
        "site": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "not": {
            "enum": [
              "shared",
              "unspecified"
            ]
          }
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "not": {
            "enum": [
              "shared",
              "unspecified"
            ]
          }
        }
      },
      "required": [
        "multiDC",
        "site",
        "region"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "port"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "tlsSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      },
      "required": [
        "enabled",
        "className",
        "annotations",
        "host",
        "tlsSecret"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "create",
        "name",
        "annotations"
      ]
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 40,
      "maximum": 3600
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ]
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "unhealthyPodEvictionPolicy": {
          "enum": [
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        }
      },
      "required": [
        "enabled",
        "minAvailable",
        "unhealthyPodEvictionPolicy"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "enabled",
        "ingress"
      ]
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "oneOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "valueFrom"
            ]
          }
        ]
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "tokenKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "enabled",
            "labels"
          ]
        }
      },
      "required": [
        "enabled",
        "labels",
        "interval",
        "scrapeTimeout",
        "existingSecret",
        "tokenKey",
        "prometheusRule"
      ]
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxSkew": {
            "type": "integer",
            "minimum": 1
          },
          "topologyKey": {
            "type": "string",
            "minLength": 1
          },
          "whenUnsatisfiable": {
            "enum": [
              "DoNotSchedule",
              "ScheduleAnyway"
            ]
          },
          "minDomains": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "maxSkew",
          "topologyKey",
          "whenUnsatisfiable"
        ]
      }
    }
  },
  "required": [
    "replicaCount",
    "nameOverride",
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "storage",
    "persistence",
    "database",
    "encryption",
    "config",
    "topology",
    "service",
    "ingress",
    "serviceAccount",
    "podAnnotations",
    "podSecurityContext",
    "securityContext",
    "resources",
    "terminationGracePeriodSeconds",
    "autoscaling",
    "podDisruptionBudget",
    "networkPolicy",
    "nodeSelector",
    "tolerations",
    "affinity",
    "extraEnv",
    "extraVolumes",
    "extraVolumeMounts",
    "tests",
    "monitoring",
    "topologySpreadConstraints"
  ]
}
